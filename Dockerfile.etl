# =====================================================================
# ITI-821 | Escenario 8: Turismo Inteligente
# Imagen del ETL para correr en AWS ECS Fargate (sin depender de una PC).
#
# Incluye Python + Microsoft ODBC 18 + bcp (mssql-tools18). Dentro de AWS
# la conexion a RDS usa la red interna, asi que el TLS de PostgreSQL ya no
# se resetea y bcp puede cifrar con -u (SQL_CIFRADO=yes).
#
# Build (contexto = raiz del repo):
#   docker build -f Dockerfile.etl -t turismodw-etl .
# =====================================================================
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# --- ODBC Driver 18 + herramientas (bcp, sqlcmd) de Microsoft ---
# Se usa el paquete oficial packages-microsoft-prod.deb, que configura el
# repositorio y la clave GPG correctamente (evita el gpg/sed manual).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates gnupg unixodbc-dev \
 && curl -sSL -O https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb \
 && dpkg -i packages-microsoft-prod.deb \
 && rm packages-microsoft-prod.deb \
 && apt-get update \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 mssql-tools18 \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV PATH="${PATH}:/opt/mssql-tools18/bin"

# --- Dependencias de Python del ETL ---
WORKDIR /app
COPY 05-etl/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# --- Codigo y recursos que el ETL resuelve por ruta relativa a la raiz ---
# config.py: RAIZ_PROYECTO = <dos niveles arriba de 05-etl/etl> = /app
#   DIR_ARCHIVOS_ENTRADA = /app/03-archivos/entrada
#   DIR_SQL              = /app/04-sqlserver
COPY 05-etl/ /app/05-etl/
COPY 04-sqlserver/ /app/04-sqlserver/
COPY 03-archivos/entrada/ /app/03-archivos/entrada/

# Los archivos intermedios de bcp van a almacenamiento efimero de la task.
ENV TURISMO_DIR_TRABAJO=/tmp/etl
RUN mkdir -p /tmp/etl

WORKDIR /app/05-etl
# El destino (nube), driver, cifrado y credenciales llegan como variables de
# entorno desde la task definition; NO se hornean en la imagen.
ENTRYPOINT ["python", "run_etl.py"]
CMD ["--modo", "INCREMENTAL"]
