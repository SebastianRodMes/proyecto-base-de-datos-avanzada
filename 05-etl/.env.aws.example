# ITI-821 | Escenario 8 | Semana 4 | Integrante 1: Alex Herrera
#
# Configuracion del ETL apuntando a la infraestructura MIGRADA en AWS.
#
# Como se usa
# -----------
#   1. Correr 07-migracion/70-provisionar-aws.ps1. Deja los endpoints y las
#      contrasenas generadas en .secrets\turismodw-cloud.env (fuera de git).
#   2. Copiar este archivo como 05-etl/.env.aws y rellenar los cuatro
#      valores marcados con <...> tomandolos de ese archivo de secretos.
#      07-migracion/75-migrar-dw.ps1 tambien lo genera automaticamente.
#   3. Correr el ETL contra la nube:
#          cd 05-etl
#          cp .env.aws .env      # o exportar las variables al entorno
#          python run_etl.py --modo FULL
#
# .env.aws esta en .gitignore: NO se versiona porque lleva credenciales.
#
# La diferencia de fondo con .env.example
# ---------------------------------------
# El perfil local resuelve SQL Server por el alias TURISMODW del registro de
# Windows y usa autenticacion integrada. Nada de eso existe en la nube: hay
# que dar el endpoint completo, el puerto por separado (SQL Server usa coma,
# no dos puntos), usuario y contrasena de SQL, y TLS obligatorio.

# --- Origen migrado: RDS for PostgreSQL 16 ---
PG_HOST=<turismodw-pg>.<sufijo>.us-east-1.rds.amazonaws.com
PG_PORT=5432
PG_DB=turismo
PG_USER=turismoadmin
PG_PASSWORD=<RDS_PG_PASSWORD>
PG_TAMANO_LOTE=100000

# --- Origen migrado: MongoDB Atlas M0 ---
# La URI SRV de Atlas ya incluye usuario, contrasena y TLS.
MONGO_URI=mongodb+srv://turismodw:<clave>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=turismo_nosql
MONGO_TAMANO_LOTE=50000

# --- Destino migrado: RDS for SQL Server 2022 Express ---
# SQL_SERVIDOR lleva solo el host; el puerto va aparte en SQL_PUERTO porque
# ni la cadena ODBC ni bcp aceptan la sintaxis host:puerto.
SQL_SERVIDOR=<turismodw-sql>.<sufijo>.us-east-1.rds.amazonaws.com
SQL_PUERTO=1433
SQL_BASE=TurismoDW
SQL_DRIVER=ODBC Driver 17 for SQL Server
# RDS corta la conexion si el cliente no negocia TLS.
SQL_CIFRADO=yes
# En RDS el usuario maestro NO es 'sa': es el que se definio al provisionar.
SQL_USUARIO=turismoadmin
SQL_PASSWORD=<RDS_SQL_PASSWORD>
BCP_TAMANO_LOTE=50000

# El mismo endpoint que consume Power BI. Las 16 particiones del modelo
# semantico se repuntan con 07-migracion/repuntar-powerbi.ps1.
POWERBI_SQL_SERVIDOR=<turismodw-sql>.<sufijo>.us-east-1.rds.amazonaws.com,1433

# --- Directorio de trabajo para los archivos intermedios de bcp ---
# Sigue siendo local: bcp transmite desde el cliente, no desde el servidor.
# Con la carga completa llega a varios cientos de MB.
TURISMO_DIR_TRABAJO=D:\DB\mssql\TurismoDW\etl

# --- Volumen de los generadores (no se usan contra la nube, se dejan por
#     coherencia con .env.example y para reconciliar conteos) ---
N_RESENAS=500000
N_INTERACCIONES=1500000
N_PREFERENCIAS_JSON=6000
PCT_REGISTROS_INVALIDOS=0.02
SEMILLA=8218
