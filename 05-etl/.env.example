# ITI-821 | Escenario 8 | Semana 3 | Integrante 1
# Copie este archivo como .env y ajuste lo que difiera en su maquina.
# Las variables ya definidas en el entorno del sistema tienen prioridad.

# --- Origen: PostgreSQL (base operacional) ---
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DB=turismo
PG_USER=postgres
PG_PASSWORD=postgres
PG_TAMANO_LOTE=100000

# --- Origen: MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/
MONGO_DB=turismo_nosql
MONGO_TAMANO_LOTE=50000

# --- Destino: SQL Server ---
# TURISMODW es el alias de cliente SQL creado por 99-setup/00-setup-admin.ps1.
# Apuntar aqui al alias y no al nombre fisico es lo que permite sobrevivir
# al failover sin editar el ETL ni el .pbix.
SQL_SERVIDOR=TURISMODW
SQL_BASE=TurismoDW
SQL_DRIVER=ODBC Driver 17 for SQL Server
# Dejar vacio para usar autenticacion integrada de Windows.
SQL_USUARIO=
SQL_PASSWORD=
BCP_TAMANO_LOTE=50000

# --- Directorio de trabajo para los CSV intermedios de bcp ---
TURISMO_DIR_TRABAJO=D:\DB\mssql\TurismoDW\etl

# --- Volumen de los generadores de datos ---
N_RESENAS=500000
N_INTERACCIONES=1500000
N_PREFERENCIAS_JSON=6000
PCT_REGISTROS_INVALIDOS=0.02
SEMILLA=8218
